# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — Prime Portfolio
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in your actual values.
# NEVER commit the .env file — it's already in .gitignore.

# ── Google Calendar Integration (Booking) ────────────────────────────────────
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="your-calendar-id@gmail.com"

# ── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"

# ── Vercel Blob (if used) ────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payment Details (PurchaseModal — client-side visible) ────────────────────
NEXT_PUBLIC_BANK_NAME="Guaranty Trust Bank (GTB)"
NEXT_PUBLIC_BANK_ACCOUNT="YOUR_ACCOUNT_NUMBER"
NEXT_PUBLIC_BANK_HOLDER="Your Name"
NEXT_PUBLIC_OPAY_NUMBER="YOUR_OPAY_NUMBER"
NEXT_PUBLIC_OPAY_HOLDER="Your Name"

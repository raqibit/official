# ─────────────────────────────────────────────────────────────────────────────
# Environment Variables — Prime Portfolio
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env.local` (or `.env`) and fill in your actual values.
# NEVER commit `.env` or `.env.local` — they are already in `.gitignore`.

# ── Database (Prisma 7 SQLite) ───────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── Admin Authentication (NextAuth v5) ───────────────────────────────────────
# Generate secret with: npx auth secret
AUTH_SECRET="REPLACE_WITH_GENERATED_SECRET"
ADMIN_PASSWORD="REPLACE_WITH_YOUR_ADMIN_PASSWORD"
OWNER_EMAIL="your@email.com"
NEXTAUTH_URL="http://localhost:3000"

# ── GitHub Sync ──────────────────────────────────────────────────────────────
# Classic personal access token (github.com/settings/tokens) with `repo` scope
GITHUB_TOKEN="REPLACE_WITH_YOUR_GITHUB_TOKEN"

# ── OpenAI (AI Descriptions + DALL-E 3 Thumbnails) ───────────────────────────
OPENAI_API_KEY="REPLACE_WITH_YOUR_OPENAI_KEY"

# ── Vercel Blob (Thumbnail & Screenshot Storage) ─────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Paystack (Digital Product Checkout & Webhooks) ───────────────────────────
PAYSTACK_SECRET_KEY=""

# ── Google Calendar Integration (Booking) ────────────────────────────────────
GOOGLE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="your-calendar-id@gmail.com"

# ── Resend (Email) ───────────────────────────────────────────────────────────
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"

# ── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Payment Details (PurchaseModal — client-side visible) ────────────────────
NEXT_PUBLIC_BANK_NAME="Guaranty Trust Bank (GTB)"
NEXT_PUBLIC_BANK_ACCOUNT="YOUR_ACCOUNT_NUMBER"
NEXT_PUBLIC_BANK_HOLDER="Your Name"
NEXT_PUBLIC_OPAY_NUMBER="YOUR_OPAY_NUMBER"
NEXT_PUBLIC_OPAY_HOLDER="Your Name"
NEXT_PUBLIC_GREY_BANK="Grey Finance"
NEXT_PUBLIC_GREY_IBAN="YOUR_GREY_IBAN"
NEXT_PUBLIC_GREY_ROUTING="YOUR_ROUTING_NUMBER"
NEXT_PUBLIC_GREY_HOLDER="Your Name"
